# Copy to terraform.tfvars and fill in privately. Never commit terraform.tfvars.
# Account identifier ABCDEFG-XY12345 -> organization_name = "ABCDEFG", account_name = "XY12345"
organization_name = "ABCDEFG"
account_name      = "XY12345"
user              = "YOUR_USER"
private_key_path  = "C:/path/outside/repository/rsa_key.p8"
