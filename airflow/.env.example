SNOWFLAKE_ACCOUNT=YOUR_ORG-YOUR_ACCOUNT
SNOWFLAKE_USER=YOUR_USER
# Absolute paths on the Docker host; never commit .env or the key.
SIDEFLIX_KEYS_DIR=/absolute/path/Sideflix-Local-Secrets
SIDEFLIX_REPO_DIR=/absolute/path/Sideflix-Project
SIDEFLIX_WORK_DIR=/absolute/path/Sideflix-Project/airflow/work
PGHOST=host.docker.internal
PGDATABASE=sideflix
PGUSER=YOUR_LOCAL_POSTGRES_USER
PGPASSWORD=
# Effective host UID/GID so mounted RSA (600) and snapshots remain readable/writable.
SIDEFLIX_TASK_USER=1000:1000
ALERT_WEBHOOK_URL=
