# Runtime credentials; copy to an ignored .env or export in the terminal.
# Keep the RSA private key outside the repository.
SNOWFLAKE_ACCOUNT=YOUR_ORG-YOUR_ACCOUNT
SNOWFLAKE_USER=SIDEFLIX_PIPELINE
SNOWFLAKE_PRIVATE_KEY_FILE=/absolute/path/outside/repository/rsa_key.p8
SNOWFLAKE_ROLE=SIDEFLIX_RUNNER
