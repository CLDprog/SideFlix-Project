# Variables lues par les scripts d'ingestion (check_connection.py, puis étape 5).
# Copier en .env (non versionné) ou les définir dans le terminal. Aucun secret ici :
# seulement le chemin de la clé privée, qui reste en dehors du dépôt.
SNOWFLAKE_ACCOUNT=ABCDEFG-XY12345
SNOWFLAKE_USER=YOUR_USER
SNOWFLAKE_PRIVATE_KEY_FILE=C:/chemin/hors/du/depot/rsa_key.p8
